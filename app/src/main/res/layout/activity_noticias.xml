<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noticias y consejos"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:text="5 consejos para ahorrar siendo estudiante" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="12 ago 2026 · Resumen breve del artículo aquí..." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textStyle="bold"
        android:text="Cómo empezar a invertir con poco dinero" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10 ago 2026 · Resumen breve del artículo aquí..." />

</LinearLayout>